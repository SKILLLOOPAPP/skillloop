# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/skillloop?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Session Configuration
SESSION_SECRET=your_session_secret_key_here_change_in_production

# OpenAI API (for AI matching)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Email Configuration (optional)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Socket.IO Configuration
SOCKET_IO_CORS=http://localhost:3000
