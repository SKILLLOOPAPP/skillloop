<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - SkillLoop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/auth/signup.css">
</head>
<body>
    <div class="auth-shell">
        <div class="auth-panel">
            <div class="auth-brand">SkillLoop</div>
            <div class="auth-tagline">
                <p class="auth-tagline-main">Join a campus of skill-sharers.</p>
                <p class="auth-tagline-sub">Post what you are stuck on or what you can teach.</p>
            </div>
        </div>

        <div class="auth-form-panel">
            <h1 class="auth-heading">Create Account</h1>

            <div id="formAlert" class="auth-alert" role="alert" hidden></div>

            <form id="signupForm" novalidate>
                <div class="auth-field">
                    <label for="fullname">Full Name</label>
                    <input type="text" id="fullname" name="fullname" autocomplete="name">
                    <p class="auth-error" id="fullnameError"></p>
                </div>

                <div class="auth-field">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" autocomplete="email">
                    <p class="auth-error" id="emailError"></p>
                </div>

                <div class="auth-field-row">
                    <div class="auth-field">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" autocomplete="new-password">
                        <p class="auth-error" id="passwordError"></p>
                    </div>
                    <div class="auth-field">
                        <label for="confirm">Confirm</label>
                        <input type="password" id="confirm" name="confirm" autocomplete="new-password">
                        <p class="auth-error" id="confirmError"></p>
                    </div>
                </div>

                <div class="auth-checkbox">
                    <input type="checkbox" id="agree" name="agree">
                    <label for="agree">I agree to Terms and Privacy</label>
                </div>
                <p class="auth-error" id="agreeError"></p>

                <div class="submit">
                    <button type="submit" class="auth-submit" id="submitBtn">Create Account</button>
                </div>
            </form>

            <div class="auth-switch">
                <p class="auth-switch-prompt">Already have an account?</p>
                <p class="auth-switch-link"><a href="/signin">Sign in</a></p>
            </div>
        </div>
    </div>

  <script src="/js/auth/signup.js"></script>
</body>
</html>
