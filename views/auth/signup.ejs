<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - SkillLoop</title>
    <link rel="stylesheet" href="/css/auth/signup.css">
</head>
<body>
    <div class="page-container">
        <div class="side-panel">
            <div class="brand">SkillLoop</div>
            <div class="tagline">
                <span id="tagline-1">Join a campus of <br> skill-sharers</span>
                <span id="tagline-2">Post what you are stuck on or what you can teach.</span>
            </div>
        </div>

        <div class="form-panel">
            <span id="page-title">Create account</span>
            <form>
                <div class="field">
                    <label for="fullname">Full Name</label>
                    <input type="text" id="fullname">
                </div>

                <div class="field">
                    <label for="email">Email</label>
                    <input type="email" id="email">
                </div>

                <div class="password-row">
                    <div class="field">
                        <label for="password">Password</label>
                        <input type="password" id="password">
                    </div>
                    <div class="field">
                        <label for="confirm">Confirm</label>
                        <input type="password" id="confirm">
                    </div>
                </div>

                <div class="terms">
                    <input type="checkbox" id="agree">
                    <span>I agree to Terms and Privacy</span>
                </div>

                <div class="submit">
                    <button type="submit" class="submit-btn">Create Account</button>
                </div>
            </form>

            <div class="signin">
                <span>Already have an account?</span>
                <a href="#">Sign in</a>
            </div>
        </div>
    </div>

  <script src="/js/auth/signin.js"></script>
</body>
</html>
