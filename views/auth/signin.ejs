<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In - SkillLoop</title>
    <link rel="stylesheet" href="/css/auth/signin.css">
</head>
<body>
    <div class="page-container">
        <div class="side-panel">
            <div class="brand">SkillLoop</div>
            <div class="tagline">
                <span id="tagline-1">Join a campus of <br> skill-sharers</span>
                <span id="tagline-2">Post what you are stuck on or what you can teach.</span>
            </div>
        </div>

        <div class="form-panel">
            <span id="page-title">Welcome back</span>
            <form>
                <div class="field">
                    <label for="email">Email</label>
                    <input type="email" id="email">
                </div>

                <div class="field">
                    <label for="password">Password</label>
                    <input type="password" id="password">
                </div>

                <div class="submit">
                    <button type="submit" class="submit-btn">Sign In</button>
                </div>
            </form>

            <div class="signup">
                <span>New to SkillLoop?</span>
                <a href="#">Create an account</a>
            </div>
        </div>
    </div>

  <script src="/js/auth/signin.js"></script>
</body>
</html>
