<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In - SkillLoop</title>
</head>
<body>
  <div style="display: flex; min-height: 100vh;">
    <!-- Left Sidebar -->
    <div style="flex: 1; padding: 40px; display: flex; flex-direction: column; justify-content: center;">
      <h1 style="font-size: 32px; margin: 0 0 20px 0;">SkillLoop</h1>
      <p style="font-size: 18px; margin: 0; color: #666;">Learn what you need</p>
    </div>

    <!-- Right Form Area -->
    <div style="flex: 1; padding: 40px; display: flex; flex-direction: column; justify-content: center;">
      <div style="max-width: 400px;">
        <h2 style="font-size: 28px; margin: 0 0 30px 0;">Welcome back</h2>

        <form id="signinForm">
          <div style="margin-bottom: 20px;">
            <label for="email" style="display: block; margin-bottom: 5px;">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="john@university.edu"
              style="width: 100%; padding: 10px; border: 1px solid #ccc; box-sizing: border-box;"
            >
            <span id="emailError" style="color: red; font-size: 12px;"></span>
          </div>

          <div style="margin-bottom: 20px;">
            <label for="password" style="display: block; margin-bottom: 5px;">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              placeholder="Enter your password"
              style="width: 100%; padding: 10px; border: 1px solid #ccc; box-sizing: border-box;"
            >
            <span id="passwordError" style="color: red; font-size: 12px;"></span>
          </div>

          <div style="margin-bottom: 20px;">
            <label style="display: flex; align-items: center;">
              <input type="checkbox" id="rememberMe" name="rememberMe" style="margin-right: 8px;">
              <span>Remember me</span>
            </label>
          </div>

          <button type="submit" style="width: 100%; padding: 12px; background-color: #000; color: #fff; border: none; cursor: pointer; font-size: 16px; margin-bottom: 20px;">
            Sign in
          </button>

          <div id="successMessage" style="display: none; color: green; margin-bottom: 10px;">
            Sign in successful! Redirecting...
          </div>

          <div id="errorMessage" style="display: none; color: red; margin-bottom: 10px;"></div>
        </form>

        <p style="font-size: 14px; margin: 10px 0;">
          How to Signup? <a href="/signup" style="color: #000; text-decoration: underline;">Create account</a>
        </p>
      </div>
    </div>
  </div>

  <script src="/js/auth/signin.js"></script>
</body>
</html>
