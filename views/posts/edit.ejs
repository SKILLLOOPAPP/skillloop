<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Post – SkillLoop</title>
  <link rel="stylesheet" href="/css/post/create-post.css">
</head>
<body>

  <%- include('../partials/sidebar', { currentPage: 'posts', currentUser: currentUser }) %>

  <div id="content">
    <div id="page-title">
      <span id="create-post-title">Edit Post</span>
      <span id="create-post-subtext">Update the details of your post</span>
    </div>

    <% if (error) { %>
      <div class="form-error"><%= error %></div>
    <% } %>

    <form id="create-post-form" method="POST" action="/posts/<%= post._id %>/edit">

      <span id="post-type-label">Post Type</span>
      <div class="post-type-group" role="radiogroup" aria-label="Post type">
        <label for="offer">
          <input type="radio" name="type" id="offer" value="offer"
                 <%= post.type === 'offer' ? 'checked' : '' %> required>
          Offer
        </label>
        <label for="request">
          <input type="radio" name="type" id="request" value="request"
                 <%= post.type === 'request' ? 'checked' : '' %>>
          Request
        </label>
        <label for="exchange">
          <input type="radio" name="type" id="exchange" value="exchange"
                 <%= post.type === 'exchange' ? 'checked' : '' %>>
          Exchange
        </label>
      </div>

      <div class="text-field">
        <label for="post-title">Title</label>
        <input type="text" id="post-title" name="title"
               value="<%= post.title %>"
               placeholder="e.g., Need help with JavaScript"
               maxlength="200" required>
      </div>

      <div class="text-field">
        <label for="post-description">Description</label>
        <textarea id="post-description" name="description" rows="4"
                  placeholder="Tell others more details..."
                  maxlength="2000" required><%= post.description %></textarea>
      </div>

      <div class="text-field">
        <label for="post-skills">Skills</label>
        <input type="text" id="post-skills" name="skills"
               value="<%= (post.skills || []).join(', ') %>"
               placeholder="Add skills: JavaScript, React, Python">
      </div>

      <div class="text-field">
        <label for="post-availability">Availability</label>
        <input type="text" id="post-availability" name="availability"
               value="<%= post.availability || '' %>"
               placeholder="Weekdays after 5pm">
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-submit">Save Changes</button>
        <a href="/posts?mine=1"><button type="button" class="btn-cancel">Cancel</button></a>
      </div>

    </form>
  </div>
</body>
</html>
